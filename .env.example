# ==============================================================
# Mansehra Dental Lounge - Environment Configuration Template
# Copy this file to .env and configure with your production credentials
# ==============================================================

# Database Connection (PostgreSQL)
DATABASE_URL=Host=localhost;Port=5432;Database=dentallounge;Username=postgres;Password=your_db_password_here

# JWT Authentication (at least 32 characters)
JWT_SECRET_KEY=ReplaceWithYourSecureLongRandomSecretKeyForProductionTokens!
JWT_ISSUER=DentalLoungeApi
JWT_AUDIENCE=DentalLoungeAdmin
JWT_EXPIRY_MINUTES=480

# MailKit SMTP Credentials (Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_clinic_email@gmail.com
SMTP_PASSWORD=your_16_char_gmail_app_password
SMTP_FROM=your_clinic_email@gmail.com
APPOINTMENT_NOTIFICATION_EMAIL=clinic_reception@gmail.com

# Initial SuperAdmin Setup
ADMIN_EMAIL=admin@dentalloungemansehra.com
ADMIN_PASSWORD=Admin@DentalLounge2026!
ADMIN_NAME=Dental Lounge Administrator
