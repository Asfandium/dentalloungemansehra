# Database Connection (PostgreSQL)
# Format: Host=...;Port=5432;Database=...;Username=...;Password=...
# Or URI format: postgresql://username:password@localhost:5432/dentallounge_db
DATABASE_URL=Host=localhost;Port=5432;Database=dentallounge_db;Username=postgres;Password=YOUR_POSTGRES_PASSWORD

# Initial SuperAdmin Credentials (bootstrapped on first run)
ADMIN_EMAIL=admin@dentalloungemansehra.com
ADMIN_PASSWORD=Admin@DentalLounge2026!
ADMIN_NAME="Dental Lounge Administrator"

# JWT Secret (must be at least 32 characters long in production)
JWT_SECRET_KEY="ReplaceWithAStrongSecretKeyAtLeast32CharactersLong!"
JWT_ISSUER="DentalLoungeApi"
JWT_AUDIENCE="DentalLoungeAdmin"

# SMTP Email Configuration (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=romeobaloh003@gmail.com
SMTP_PASSWORD=YOUR_16_CHAR_GMAIL_APP_PASSWORD
SMTP_FROM=romeobaloh003@gmail.com
#APPOINTMENT_NOTIFICATION_EMAIL=asfandium.1@gmail.com
